{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "glassy": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "glassy",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["node_modules/leaflet/dist/leaflet.css", "src/styles.scss"],
            "allowedCommonJsDependencies": ["leaflet"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "510kB",
                  "maximumError": "535kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2.3kB",
                  "maximumError": "3kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "baseHref": "/"
            },
            "github-pages": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "510kB",
                  "maximumError": "535kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2.3kB",
                  "maximumError": "3kB"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/glassy/"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "glassy:build:production"
            },
            "development": {
              "buildTarget": "glassy:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "vitest-base.config.mts",
            "coverageInclude": ["src/app/**/*.ts"],
            "coverageExclude": ["src/app/**/*.spec.ts"],
            "coverageReporters": ["text-summary", "html", "lcov"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "e2e/**/*.ts",
              "scripts/**/*.ts",
              "playwright.config.ts"
            ]
          }
        }
      }
    }
  }
}
