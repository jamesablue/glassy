    "snapshot:fixtures": "tsx src/cli.ts --fixtures"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
