{
  "name": "glassy-backend",
  "version": "0.0.0",
  "description": "The forecast ingest: fetches Open-Meteo and builds the forecast.json snapshot the app reads.",
  "author": "James Blue",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
