{
  "name": "glassy-infra",
  "version": "0.0.0",
  "description": "AWS CDK app that hosts the Glassy static build in a private S3 bucket behind CloudFront.",
  "author": "James Blue",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "cdk": "cdk",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "aws-cdk-lib": "^2.274.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1146.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
