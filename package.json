{
  "name": "glassy",
  "version": "0.0.0",
  "description": "Windy-style forecast map that ranks Oahu snorkel spots by wind, swell and depth.",
  "author": "James Blue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesablue/glassy.git"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration github-pages",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:ci": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:visual": "bash scripts/e2e-visual.sh",
    "e2e:visual:update": "bash scripts/e2e-visual.sh --update-snapshots",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "fixtures:expected": "node scripts/generate-expected-scores.mjs",
    "docs:screenshots": "ng build && tsx scripts/capture-screenshots.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,scss,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
